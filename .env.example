# Local development only. Change before sharing a machine or exposing any port.
POSTGRES_DB=hsmart_dev
POSTGRES_USER=hsmart_dev
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://hsmart_dev:replace-with-a-local-only-password@localhost:5432/hsmart_dev

# Local first-party pilot only. Configure after running oidc-test-keygen.
HSMART_ENV=development
HSMART_OIDC_ISSUER=https://issuer.hsmart.test
HSMART_OIDC_AUDIENCE=hsmart-api
HSMART_OIDC_PUBLIC_KEY_FILE=.local/keys/oidc-test-public.pem
HSMART_PILOT_ACCESS_TOKEN=
HSMART_PILOT_HOST_ID=hsmart-local-mcp-host-v1
HSMART_ARTIFACT_STORE=.hsmart-artifacts
