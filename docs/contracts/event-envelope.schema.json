{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hsmart.example/v1/event-envelope.schema.json",
  "title": "HSMART Domain Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "producer", "aggregateId", "data"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$" },
    "eventVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "organizationId": { "type": "string" },
    "tenantId": { "type": "string" },
    "aggregateId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string" },
    "causationId": { "type": "string" },
    "data": { "type": "object" },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traceparent": { "type": "string" },
        "tracestate": { "type": "string" }
      }
    }
  }
}
